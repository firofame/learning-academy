{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "placement": {
    "region": "gcp:asia-south1"
  },
  "kv_namespaces": [
    {
      "binding": "PROGRESS_KV",
      "id": "1f2fbfe674bb4311820a1fb69f082a18"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/grade", "/api/*"]
  },
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://learn.firofame.workers.dev,https://learning-academy-grading.firofame.workers.dev,https://firofame.github.io,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:8787"
  },
  "ratelimits": [
    {
      "name": "GRADING_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
}
