{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-academy-grading",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "placement": {
    "region": "gcp:asia-south1"
  },
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GRADING_QUOTA", "class_name": "GradingQuota" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GradingQuota"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://firofame.github.io,http://localhost:3000,http://127.0.0.1:3000"
  },
  "ratelimits": [
    {
      "name": "GRADING_IP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
